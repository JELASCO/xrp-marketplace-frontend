# ============================================================================
# XRP Marketplace (XRPHarbor) — Frontend Environment Configuration (.env.example)
# Copy this file to .env.local for local development. NEVER commit real secrets!
# ============================================================================

# Public Frontend & API Endpoints
NEXT_PUBLIC_SITE_URL=https://xrpharbor.com
NEXT_PUBLIC_API_URL=https://xrp-marketplace-backend-production.up.railway.app
NEXT_PUBLIC_SOCKET_URL=https://xrp-marketplace-backend-production.up.railway.app
FRONTEND_URL=https://xrpharbor.com
BACKEND_URL=https://xrp-marketplace-backend-production.up.railway.app

# Public XRPL Network Display Config
NEXT_PUBLIC_XRPL_NETWORK=mainnet
NEXT_PUBLIC_XRPL_NODE=wss://xrplcluster.com

# Server-Side Fallback Route Secrets (Next.js Route Handler only — never NEXT_PUBLIC_)
DATABASE_URL=postgresql://postgres:CHANGE_ME_PASSWORD@localhost:5432/xrp_marketplace
JWT_SECRET=CHANGE_ME_TO_A_64_CHAR_RANDOM_HEX_SECRET
XUMM_API_KEY=00000000-0000-0000-0000-000000000000
XUMM_API_SECRET=00000000-0000-0000-0000-000000000000
XRPL_NODE=wss://xrplcluster.com
PLATFORM_WALLET=rChangeMePlatformWalletAddressXXXXXXX
PLATFORM_WALLET_SEED=sEdChangeMeNeverCommitRealWalletSeedXXXX
IMGBB_API_KEY=CHANGE_ME_IMGBB_API_KEY

# Transactional Email Notifications & OTP Verification (Resend HTTP API or Standard SMTP)
PUBLIC_APP_URL=https://xrpharbor.com
EMAIL_FROM="XRPHarbor <notifications@xrpharbor.com>"
EMAIL_OTP_SECRET=CHANGE_ME_TO_A_64_CHAR_RANDOM_HEX_OTP_HMAC_SECRET
RESEND_API_KEY=re_CHANGE_ME_RESEND_API_KEY
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD

